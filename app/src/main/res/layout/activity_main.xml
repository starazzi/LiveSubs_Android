<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textColor="#1E88E5" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:id="@+id/t_desc" android:text="@string/desc" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:id="@+id/t_my_lang" android:text="@string/my_lang" />
        <Spinner android:id="@+id/spinnerTgt"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:id="@+id/t_engine" android:text="@string/engine_label" />
        <Spinner android:id="@+id/spinnerEngine"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:id="@+id/t_stream_lang" android:text="@string/stream_lang" />
        <Spinner android:id="@+id/spinnerSrc"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchOriginal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/show_orig" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchOnline"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/online_tr" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:id="@+id/t_appearance" android:text="@string/appearance"
            android:textSize="18sp" android:textStyle="bold" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="#777777" android:padding="12dp">
            <TextView android:id="@+id/preview"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:padding="12dp" android:text="@string/preview" />
        </FrameLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:id="@+id/t_text_color" android:text="@string/text_color" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/rowText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:id="@+id/t_text_size" android:text="@string/text_size" />
        <SeekBar android:id="@+id/seekSize"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:id="@+id/t_bg_color" android:text="@string/bg_color" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/rowBg"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:id="@+id/t_bg_opacity" android:text="@string/bg_opacity" />
        <SeekBar android:id="@+id/seekAlpha"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <Button android:id="@+id/btnStart"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/start" />
        <Button android:id="@+id/btnStop"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/stop" />

        <ProgressBar android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:max="100" android:visibility="gone" />
        <TextView android:id="@+id/status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/ready" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:textSize="13sp" android:id="@+id/t_howto" android:text="@string/howto" />
    </LinearLayout>
</ScrollView>
